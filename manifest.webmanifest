{
  "name": "PinLog",
  "short_name": "PinLog",
  "description": "A private log for TRT: doses, schedules, injection sites, stock, body metrics and bloodwork. Everything stays on your device.",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EEF1EF",
